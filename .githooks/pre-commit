#!/usr/bin/env bash
# Reject staged files > 50MB (conservative; under GitHub's 100MB hard limit).
# Files tracked by Git LFS are exempt (LFS pointer files are tiny).
set -euo pipefail
limit=$((50 * 1024 * 1024))
fail=0
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  # Skip files tracked by Git LFS
  if git check-attr filter "$f" 2>/dev/null | grep -q 'filter: lfs$'; then
    continue
  fi
  size=$(wc -c <"$f" | tr -d ' ')
  if [ "$size" -gt "$limit" ]; then
    echo "BLOCKED (>50MB): $f ($size bytes)" >&2
    fail=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)
exit "$fail"
